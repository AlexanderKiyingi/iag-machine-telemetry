# machine-telemetry — production machine IoT ingest for iag-production + iag-mes.
SERVICE_NAME=machine-telemetry
LOG_LEVEL=info
LOG_FORMAT=text

# HTTP ingest (cmd/ingest)
ADDR=:4090
# TCP MTP gateway (cmd/gateway)
IOT_ADDR=:5037

# Timeseries DB (mes_machine_telemetry hypertable, mes_machine_oee_daily).
# Requires the TimescaleDB extension on the readings hypertable.
# Tables are created by MES migration 006_machine_telemetry.sql in the `mes`
# schema, keyed on asset_tag, so the DSN must put mes on the search_path.
DATABASE_URL=postgres://svc_machine-telemetry:iag_machine-telemetry_dev@localhost:5432/iag_platform?sslmode=disable&options=-c%20search_path%3Dmes,public
# Split-DB only: operational/CMMS DB (mes_assets, mes_asset_telemetry_latest,
# mes_downtime_events, mes_iot_devices). Same schema as the MES DATABASE_URL.
# Unset = single-DB dev mode.
# REGISTRY_DATABASE_URL=

# Optional live fan-out across replicas
# REDIS_URL=redis://localhost:6379/0

# Aggregator (cmd/aggregate)
# IDEAL_CYCLES_PER_MIN=  # machine nameplate throughput; enables Performance + OEE
# PURGE_DAYS=180         # drop raw readings older than N days after rollup
# AGG_FROM=2026-06-01
# AGG_TO=2026-06-13

# Connection pool tuning
# DB_MAX_CONNS=30
# DB_MIN_CONNS=2
# MAX_TRACK_ROWS=50000
