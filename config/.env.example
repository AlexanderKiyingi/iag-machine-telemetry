# machine-telemetry — production machine IoT ingest for iag-production + iag-mes.
SERVICE_NAME=machine-telemetry
LOG_LEVEL=info
LOG_FORMAT=text

# HTTP ingest (cmd/ingest)
ADDR=:4090
# TCP MTP gateway (cmd/gateway)
IOT_ADDR=:5037

# Timeseries DB (machine_telemetry_timeseries, machine_telemetry_daily, machine_downtime_events).
# Requires the TimescaleDB extension on the readings hypertable.
DATABASE_URL=postgres://svc_machine-telemetry:iag_machine-telemetry_dev@localhost:5432/iag_platform?sslmode=disable
# Split-DB only: operational registry (machine_iot_devices, machines hot-state).
# Same DSN as iag-production DATABASE_URL. Unset = single-DB dev mode.
# REGISTRY_DATABASE_URL=

# Optional live fan-out across replicas
# REDIS_URL=redis://localhost:6379/0

# Aggregator (cmd/aggregate)
# IDEAL_CYCLES_PER_MIN=  # machine nameplate throughput; enables Performance + OEE
# PURGE_DAYS=180         # drop raw readings older than N days after rollup
# AGG_FROM=2026-06-01
# AGG_TO=2026-06-13

# Connection pool tuning
# DB_MAX_CONNS=30
# DB_MIN_CONNS=2
# MAX_TRACK_ROWS=50000
